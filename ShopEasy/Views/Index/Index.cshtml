@model IEnumerable<ShopEasy.Models.ProductType>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ShopEasy</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #14231f;
            --muted: #5d6d68;
            --line: #dfe6e3;
            --bg: #f4f7f6;
            --card: #ffffff;
            --brand: #0f5c4d;
            --brand-dark: #0a4036;
            --accent: #f2a900;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            color: var(--ink);
            background: var(--bg);
            line-height: 1.5;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        :focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 2px;
        }

        .wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* top bar */
        .topbar {
            background: var(--brand-dark);
            color: #d7e6e1;
            font-size: 13px;
        }

            .topbar .wrap {
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 8px 24px;
                padding-top: 8px;
                padding-bottom: 8px;
            }

            .topbar ul {
                list-style: none;
                display: flex;
                gap: 20px;
                flex-wrap: wrap;
            }

            .topbar a:hover {
                color: #fff;
                text-decoration: underline;
            }

        /* header */
        header.main {
            background: var(--card);
            border-bottom: 1px solid var(--line);
        }

            header.main .wrap {
                display: grid;
                grid-template-columns: auto 1fr auto;
                gap: 24px;
                align-items: center;
                padding-top: 16px;
                padding-bottom: 16px;
            }

        .logo {
            font-size: 26px;
            font-weight: 800;
            color: var(--brand);
            letter-spacing: -0.5px;
        }

            .logo img {
                height: 40px;
                display: block;
            }

        .search {
            display: flex;
            max-width: 620px;
            width: 100%;
            margin: 0 auto;
            border: 2px solid var(--brand);
            border-radius: 999px;
            overflow: hidden;
        }

            .search select {
                border: 0;
                padding: 0 16px;
                background: #eef3f1;
                font: inherit;
                font-size: 14px;
                max-width: 200px;
            }

            .search button {
                border: 0;
                background: var(--brand);
                color: #fff;
                font: inherit;
                font-weight: 700;
                padding: 12px 26px;
                cursor: pointer;
            }

                .search button:hover {
                    background: var(--brand-dark);
                }

        .actions a {
            font-weight: 500;
            font-size: 14px;
            padding: 8px 12px;
            border-radius: 8px;
        }

            .actions a:hover {
                background: var(--bg);
            }

        .badge {
            background: var(--accent);
            color: var(--ink);
            font-size: 12px;
            font-weight: 700;
            border-radius: 999px;
            padding: 1px 8px;
            margin-left: 4px;
        }

        /* products */
        .products {
            padding: 36px 0 56px;
        }

            .products h1 {
                font-size: 28px;
                font-weight: 800;
                margin-bottom: 4px;
            }

            .products .sub {
                color: var(--muted);
                margin-bottom: 24px;
            }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 20px;
        }

        .product {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

            .product .img {
                position: relative;
                aspect-ratio: 1 / 1;
                background: #eef3f1;
                display: grid;
                place-items: center;
            }

                .product .img img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    padding: 14px;
                }

            .product .tools {
                position: absolute;
                top: 10px;
                right: 10px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                .product .tools button {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    border: 1px solid var(--line);
                    background: #fff;
                    cursor: pointer;
                    font-size: 15px;
                }

                    .product .tools button:hover {
                        background: var(--accent);
                        border-color: var(--accent);
                    }

            .product .body {
                padding: 14px 16px 6px;
                flex: 1;
            }

        .cat {
            color: var(--brand);
            font-size: 13px;
            font-weight: 500;
        }

        .name {
            font-size: 16px;
            font-weight: 700;
            margin: 2px 0 6px;
        }

            .name a:hover {
                color: var(--brand);
            }

        .price {
            font-size: 20px;
            font-weight: 800;
        }

        .stars {
            color: var(--accent);
            letter-spacing: 2px;
            font-size: 14px;
            margin-top: 4px;
        }

        .add {
            margin: 12px 16px 16px;
            padding: 11px;
            border: 0;
            border-radius: 10px;
            background: var(--brand);
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

            .add:hover {
                background: var(--brand-dark);
            }

        .empty {
            background: var(--card);
            border: 1px dashed var(--line);
            border-radius: 14px;
            padding: 48px 20px;
            text-align: center;
            color: var(--muted);
        }

        /* newsletter */
        .news {
            background: var(--brand);
            color: #fff;
            padding: 40px 0;
            text-align: center;
        }

            .news h2 {
                font-size: 22px;
                margin-bottom: 14px;
            }

            .news form {
                display: flex;
                max-width: 480px;
                margin: 0 auto;
            }

            .news input {
                flex: 1;
                padding: 13px 18px;
                border: 0;
                border-radius: 999px 0 0 999px;
                font: inherit;
                min-width: 0;
            }

            .news button {
                border: 0;
                background: var(--accent);
                color: var(--ink);
                font: inherit;
                font-weight: 700;
                padding: 0 24px;
                border-radius: 0 999px 999px 0;
                cursor: pointer;
            }

        /* footer */
        footer {
            background: #0d1a17;
            color: #b8c6c1;
            padding: 44px 0 20px;
            font-size: 14px;
        }

        .fcols {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 28px;
            margin-bottom: 28px;
        }

        footer h3 {
            color: #fff;
            font-size: 15px;
            margin-bottom: 10px;
        }

        footer ul {
            list-style: none;
        }

        footer li {
            margin-bottom: 6px;
        }

        footer a:hover {
            color: #fff;
            text-decoration: underline;
        }

        .copy {
            border-top: 1px solid #25362f;
            padding-top: 16px;
            text-align: center;
            font-size: 13px;
        }

        @@media (max-width: 760px) {
            header.main .wrap {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .search select {
                max-width: 120px;
            }

            .actions {
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="wrap">
            <ul>
                <li>+021-95-51-84</li>
                <li>shopeasybuy@gmail.com</li>
                <li>1734 Stonecoal Road</li>
            </ul>
            <ul>
                <li><a href="~/Index/Register">Register</a></li>
                <li><a href="~/Index/Login">Login</a></li>
            </ul>
        </div>
    </div>

    <header class="main">
        <div class="wrap">
            <a href="~/" class="logo">ShopEasy</a>

            <form class="search" asp-action="Filter" method="get" role="search">
                <select name="cat" aria-label="Category">
                    <option value="0">All categories</option>
                    @if (ViewBag.type != null)
                    {
                        foreach (var item in ViewBag.type)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <button type="submit">Search</button>
            </form>

            <nav class="actions">
                <a href="Login">Wishlist <span class="badge">0</span></a>
            </nav>
        </div>
    </header>

    <main class="products">
        <div class="wrap">
            <h1>Shop our products</h1>
            <p class="sub">Pick a category above, or browse everything below.</p>

            @if (Model != null && Model.Any())
            {
                <div class="grid">
                    @foreach (var item in Model)
                    {
                        var firstImage = (item.ImagePath ?? "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .FirstOrDefault();

                        <article class="product">
                            <div class="img">
                                <img src="~/Products/@(firstImage ?? "no-image.png")" alt="@item.ProductName" loading="lazy">
                                <div class="tools">
                                    <button type="button">
                                        <a asp-controller="Index"
                                           asp-action="Login"
                                           title="Add to wishlist"
                                           aria-label="Add to wishlist">
                                            &#9825;
                                        </a>

                                    </button>
                                   
                                    <button type="button">
                                        <a asp-controller="Index"
                                        asp-action="Login"
                                        title="Quick view"
                                           aria-label="Quick view">
                                            &#128065;
                                        </a>
                                        
                                    </button>
                                </div>
                            </div>
                            <div class="body">
                                <p class="cat">@item.CategoryModel?.CategoryName</p>
                                <h2 class="name"><a href="#">@item.ProductName</a></h2>
                                <p class="price">$@item.Price.ToString("0.00")</p>
                                <div class="stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            </div>
                            <button type="button" class="add">

                                <a asp-action="Login" asp-controller="Index">Add to cart</a>
                            </button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty">No products found. Try another category.</div>
            }
        </div>
    </main>

    <section class="news">
        <div class="wrap">
            <h2>Get new arrivals in your inbox</h2>
            <form>
                <input type="email" placeholder="Your email address" aria-label="Email address" required>
                <button type="submit">Subscribe</button>
            </form>
        </div>
    </section>

    <footer>
        <div class="wrap">
            <div class="fcols">
                <div>
                    <h3>About us</h3>
                    <p>ShopEasy brings everyday essentials to your door.</p>
                </div>
                <div>
                    <h3>Categories</h3>
                    <ul>
                        <li><a href="#">Hot deals</a></li>
                        <li><a href="#">Laptops</a></li>
                        <li><a href="#">Smartphones</a></li>
                        <li><a href="#">Accessories</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Information</h3>
                    <ul>
                        <li><a href="#">Contact us</a></li>
                        <li><a href="#">Privacy policy</a></li>
                        <li><a href="#">Orders and returns</a></li>
                        <li><a href="#">Terms and conditions</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Service</h3>
                    <ul>
                        <li><a href="#">My account</a></li>
                        <li><a href="#">View cart</a></li>
                        <li><a href="#">Track my order</a></li>
                        <li><a href="#">Help</a></li>
                    </ul>
                </div>
            </div>
            <p class="copy">&copy; @DateTime.Now.Year ShopEasy. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
