    <!-- ORDER SUCCESS JAVASCRIPT -->

    <script>
        const successMessage =
            document.getElementById("orderSuccess");

        if (successMessage) {
            setTimeout(function () {
                successMessage.classList.add("hide");

                setTimeout(function () {
                    successMessage.remove();
                }, 500);

            }, 5000);
        }

        function closeSuccess() {
            const message =
                document.getElementById("orderSuccess");

            if (message) {
                message.classList.add("hide");

                setTimeout(function () {
                    message.remove();
                }, 500);
            }
        }
    </script>

