
@model ShopEasy.Models.ProductCategory
@using ShopEasy.Models

@{
    ViewData["Title"] = "Category Management";
    var categories = ViewBag.category as List<ProductCategory>
                     ?? new List<ProductCategory>();
}

<style>
    .category-page {
        padding: 24px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .page-heading {
        margin-bottom: 25px;
    }

    .page-heading h2 {
        color: #253047;
        font-size: 27px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .page-heading p {
        color: #7b8497;
        margin: 0;
        font-size: 14px;
    }

    .category-card {
        background: #fff;
        border: 1px solid #e8ecf3;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 18px rgba(31, 45, 61, 0.04);
        height: 100%;
    }

    .card-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 22px;
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f5;
    }

    .card-heading h4 {
        color: #253047;
        font-size: 17px;
        font-weight: 700;
        margin: 0;
    }

    .card-heading p {
        color: #8992a4;
        font-size: 12px;
        margin: 5px 0 0;
    }

    .category-label {
        display: block;
        color: #3c465b;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .category-input {
        width: 100%;
        border: 1px solid #dce2eb;
        border-radius: 7px;
        padding: 11px 12px;
        font-size: 14px;
        color: #344054;
        background: #fff;
        transition: border-color .2s, box-shadow .2s;
    }

    .category-input:focus {
        outline: none;
        border-color: #4b7bec;
        box-shadow: 0 0 0 3px rgba(75, 123, 236, .12);
    }

    textarea.category-input {
        resize: vertical;
        min-height: 125px;
    }

    .btn-save-category {
        background: #3563e9;
        border: none;
        border-radius: 7px;
        padding: 11px 18px;
        color: white;
        font-size: 14px;
        font-weight: 600;
        width: 100%;
        margin-top: 8px;
        cursor: pointer;
        transition: background .2s;
    }

    .btn-save-category:hover {
        background: #244fc9;
    }

    .category-count {
        display: inline-block;
        background: #edf2ff;
        color: #3563e9;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .category-search {
        width: 100%;
        max-width: 260px;
        border: 1px solid #dce2eb;
        border-radius: 7px;
        padding: 9px 12px;
        font-size: 13px;
        outline: none;
    }

    .category-search:focus {
        border-color: #4b7bec;
    }

    .category-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .category-table thead th {
        background: #f7f9fc;
        color: #667085;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 14px 12px;
        border-bottom: 1px solid #e9edf4;
        text-align: left;
        white-space: nowrap;
    }

    .category-table tbody td {
        color: #475467;
        font-size: 13px;
        padding: 16px 12px;
        border-bottom: 1px solid #f0f2f6;
        vertical-align: middle;
    }

    .category-table tbody tr:hover {
        background: #fafbfe;
    }

    .category-name {
        color: #253047;
        font-weight: 600;
    }

    .category-description {
        min-width: 150px;
        max-width: 280px;
        overflow-wrap: anywhere;
        line-height: 1.5;
    }

    .category-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #eef3ff;
        color: #3563e9;
        font-size: 13px;
        font-weight: 700;
    }

    .btn-delete-category {
        display: inline-block;
        padding: 7px 11px;
        border: 1px solid #f2caca;
        border-radius: 6px;
        color: #d14343;
        background: #fff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .btn-delete-category:hover {
        background: #fff1f1;
        color: #b42318;
    }

    .empty-category {
        padding: 45px 15px !important;
        text-align: center;
        color: #8a94a6 !important;
    }

    .empty-category strong {
        display: block;
        color: #344054;
        margin-bottom: 5px;
    }

    @@media (max-width: 991px) {
        .category-page {
            padding: 16px;
        }

        .category-card {
            padding: 18px;
        }
    }

    @@media (max-width: 575px) {
        .page-heading h2 {
            font-size: 23px;
        }

        .card-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .category-search {
            max-width: 100%;
        }
    }
</style>

<div class="category-page">

    <div class="page-heading">
        <h2>Category Management</h2>
        <p>Create and organize the product categories available in ShopEasy.</p>
    </div>

    <div class="row g-4">

        <!-- Left: Add category form (5 columns) -->
        <div class="col-12 col-lg-5">
            <div class="category-card">

                <div class="card-heading">
                    <div>
                        <h4>Add New Category</h4>
                        <p>Enter the category details below.</p>
                    </div>
                </div>

                <form asp-controller="Admin"
                      asp-action="Save"
                      method="post">

                    <div class="mb-4">
                        <label class="category-label" for="CategoryName">
                            Category Name
                        </label>

                        @Html.TextBoxFor(
                            m => m.CategoryName,
                            new {
                                @class = "category-input",
                                placeholder = "e.g. Electronics",
                                id = "CategoryName"
                            })
                    </div>

                    <div class="mb-4">
                        <label class="category-label" for="desc">
                            Description
                        </label>

                        @Html.TextAreaFor(
                            m => m.desc,
                            new {
                                @class = "category-input",
                                placeholder = "Describe the products in this category...",
                                rows = "5",
                                id = "desc"
                            })
                    </div>

                    <button type="submit" class="btn-save-category">
                        + Save Category
                    </button>

                </form>
            </div>
        </div>

        <!-- Right: Existing categories (7 columns) -->
        <div class="col-12 col-lg-7">
            <div class="category-card">

                <div class="card-heading">
                    <div>
                        <h4>Existing Categories</h4>
                        <p>View and manage your product categories.</p>
                    </div>

                    <span class="category-count">
                        @categories.Count Categories
                    </span>
                </div>

                <div class="mb-3">
                    <input type="text"
                           id="categorySearch"
                           class="category-search"
                           placeholder="Search categories..."
                           aria-label="Search categories" />
                </div>

                <div class="category-table-wrap">
                    <table class="category-table">
                        <thead>
                            <tr>
                                <th style="width: 55px;">No.</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th style="width: 90px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="categoryTableBody">
                            @if (categories.Any())
                            {
                                var index = 0;

                                foreach (var item in categories)
                                {
                                    index++;

                                    <tr class="category-row">
                                        <td>
                                            <span class="category-number">
                                                @index
                                            </span>
                                        </td>

                                        <td>
                                            <span class="category-name">
                                                @item.CategoryName
                                            </span>
                                        </td>

                                        <td>
                                            <div class="category-description">
                                                @(string.IsNullOrWhiteSpace(item.desc)
                                                    ? "No description provided"
                                                    : item.desc)
                                            </div>
                                        </td>

                                        <td>
                                            @Html.ActionLink(
                                                "Delete",
                                                "Delete",
                                                new { id = item.CategoryId },
                                                new {
                                                    @class = "btn-delete-category",
                                                    onclick = "return confirm('Are you sure you want to delete this category?');"
                                                })
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="emptyCategoryRow">
                                    <td colspan="4" class="empty-category">
                                        <strong>No categories found</strong>
                                        Add your first category using the form.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p id="noSearchResults"
                   style="display:none; text-align:center; padding:20px; color:#8992a4; font-size:13px;">
                    No matching categories found.
                </p>

            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById("categorySearch").addEventListener("input", function () {
        const searchText = this.value.toLowerCase().trim();
        const rows = document.querySelectorAll(".category-row");
        let visibleCount = 0;

        rows.forEach(function (row) {
            const matches = row.textContent.toLowerCase().includes(searchText);
            row.style.display = matches ? "" : "none";

            if (matches) {
                visibleCount++;
            }
        });

        const noResults = document.getElementById("noSearchResults");
        if (noResults) {
            noResults.style.display =
                rows.length > 0 && visibleCount === 0 ? "block" : "none";
        }
    });
</script>
