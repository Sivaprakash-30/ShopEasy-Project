@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Sales Review";
}

<style>
    .sales-page {
        background: #f4f7fc;
        min-height: 100vh;
        padding: 30px;
        border-radius: 14px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .page-heading h2 {
            color: #172b4d;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-heading p {
            color: #77849a;
            margin: 0;
        }

    .total-products {
        background: white;
        color: #2563eb;
        padding: 13px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        font-weight: 600;
    }

    .product-card {
        background: white;
        height: 100%;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(30,50,80,.05);
        transition: transform .2s, box-shadow .2s;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(30,50,80,.12);
        }

    .product-image {
        width: 100%;
        height: 220px;
        object-fit: contain;
        padding: 15px;
        background: #f8fafc;
    }

    .product-body {
        padding: 20px;
    }

    .product-title {
        color: #172b4d;
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 7px;
        overflow-wrap: anywhere;
    }

    .product-id {
        color: #8a97aa;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .product-price {
        color: #172b4d;
        font-size: 23px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .quantity-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ecfdf5;
        color: #087443;
        border-radius: 10px;
        padding: 13px;
        margin-bottom: 20px;
    }

        .quantity-box strong {
            font-size: 19px;
        }

    .seller-section {
        border-top: 1px solid #edf0f5;
        padding-top: 16px;
    }

    .seller-heading {
        color: #172b4d;
        font-weight: 700;
        font-size: 15px;
        margin-bottom: 13px;
    }

    .seller-detail {
        display: flex;
        gap: 9px;
        margin-bottom: 10px;
        font-size: 13px;
        color: #64748b;
        overflow-wrap: anywhere;
    }

        .seller-detail strong {
            color: #334155;
            min-width: 65px;
        }

    .seller-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        font-size: 12px;
        padding: 5px 9px;
        border-radius: 20px;
        margin-bottom: 12px;
    }

    .empty-state {
        background: white;
        border-radius: 15px;
        text-align: center;
        padding: 55px 20px;
        color: #77849a;
    }

        .empty-state h4 {
            color: #172b4d;
            margin: 12px 0;
        }

    @@media (max-width: 576px) {
        .sales-page {
            padding: 15px;
        }

        .product-image {
            height: 190px;
        }
    }
</style>

<div class="sales-page">

    <div class="page-heading">
        <div>
            <h2>📊 Sales Review</h2>
            <p>Most purchased products.</p>
        </div>

        <div class="total-products">
            📦 Products: @(Model?.Count() ?? 0)
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                string path = item.Image ?? "";
                string fileName = path.Split(',')
                .FirstOrDefault()?.Trim() ?? "";

                <div class="col-12 col-md-6 col-xl-4">

                    <div class="product-card">

                        @if (!string.IsNullOrEmpty(fileName))
                        {
                            <img src="@Url.Content("~/Products/" + fileName)"
                                 class="product-image"
                                 alt="@item.productname" />
                        }
                        else
                        {
                            <div class="product-image d-flex justify-content-center align-items-center">
                                <span class="text-muted">No image available</span>
                            </div>
                        }

                        <div class="product-body">

                            <span class="seller-badge">
                                Product #@item.pid
                            </span>

                            <div class="product-title">
                                @item.productname
                            </div>

                            <div class="product-price">
                                ₹@item.Price
                            </div>

                            <div class="quantity-box">
                                <span>🛒 Total Quantity Sold</span>
                                <strong>@item.Quantity</strong>
                            </div>

                            <div class="seller-section">

                                <div class="seller-heading">
                                    👤 Seller Information
                                </div>

                                <div class="seller-detail">
                                    <strong>Name</strong>
                                    <span>@item.sellername</span>
                                </div>

                                <div class="seller-detail">
                                    <strong>Email</strong>
                                    <span>@item.selleremail</span>
                                </div>

                                <div class="seller-detail">
                                    <strong>Contact</strong>
                                    <span>@item.Sellerphone</span>
                                </div>

                                <div class="seller-detail">
                                    <strong>Owner</strong>
                                    <span>@item.owner</span>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 45px;">📦</div>
            <h4>No Sales Records Found</h4>
            <p>Product sales and seller information will appear here when matching order records are available.</p>
        </div>
    }

</div>