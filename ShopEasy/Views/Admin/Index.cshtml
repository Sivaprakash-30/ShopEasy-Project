
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Seller Dashboard";
}

<style>
    .dashboard {
        padding: 25px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .welcome-box {
        background: #eaf3ff;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
    }

        .welcome-box h1 {
            font-size: 30px;
            font-weight: 600;
            color: #172b4d;
            margin-bottom: 10px;
        }

        .welcome-box p {
            color: #53657d;
            font-size: 16px;
            margin-bottom: 0;
        }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .dashboard-card {
        background: white;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #e2e6ed;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }

        .dashboard-card h3 {
            font-size: 17px;
            margin-bottom: 15px;
            color: #172b4d;
        }

        .dashboard-card .number {
            font-size: 32px;
            font-weight: bold;
            color: #172b4d;
            margin-bottom: 15px;
        }

        .dashboard-card a {
            display: block;
            text-decoration: none;
            padding: 10px 15px;
            background: #eef5ff;
            border-radius: 20px;
            color: #1266d6;
            text-align: center;
        }

            .dashboard-card a:hover {
                background: #dceaff;
            }

    .section-box {
        background: white;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #e2e6ed;
        margin-bottom: 25px;
    }

        .section-box h2 {
            font-size: 22px;
            color: #172b4d;
            margin-bottom: 20px;
        }

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

        .order-table th {
            background: #eef5ff;
            color: #172b4d;
            padding: 14px;
            text-align: left;
            white-space: nowrap;
        }

        .order-table td {
            padding: 14px;
            border-bottom: 1px solid #e2e6ed;
            vertical-align: middle;
        }

        .order-table tbody tr:hover {
            background: #f8faff;
        }

    .product-image {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e6ed;
    }

    .no-orders {
        text-align: center;
        padding: 30px;
        color: #7b8798;
    }

    .recent p {
        text-align: center;
        padding: 25px;
        color: #7b8798;
        margin-bottom: 0;
    }

    /* Order search bar */
    .order-search {
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: 400px;
        margin-bottom: 20px;
    }

        .order-search input {
            width: 100%;
            padding: 11px 15px;
            border: 1px solid #d6deea;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
            background: #fff;
            transition: border-color .2s, box-shadow .2s;
        }

            .order-search input:focus {
                border-color: #1266d6;
                box-shadow: 0 0 0 3px rgba(18, 102, 214, 0.12);
            }

        .order-search .search-icon {
            color: #53657d;
            font-size: 18px;
        }

    .no-search-results td {
        text-align: center;
        padding: 25px;
        color: #7b8798;
    }

    @@media (max-width: 900px) {
        .dashboard-cards {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard {
            padding: 12px;
        }

        .welcome-box,
        .dashboard-card,
        .section-box {
            padding: 18px;
        }

            .welcome-box h1 {
                font-size: 24px;
            }

        .order-search {
            max-width: 100%;
        }
    }
</style>

<div class="dashboard">

    <!-- Welcome Section -->
    <div class="welcome-box">
        <h1>Welcome, Admin! 👋</h1>
        <p>
            Manage your products, stock and orders from your seller dashboard.
        </p>
    </div>

    <!-- Summary Cards -->
    @*
    <div class="dashboard-cards">

        <div class="dashboard-card">
            <h3>📦 Total Products</h3>
            <div class="number">@(ViewBag.cnt ?? 0)</div>
            <a asp-controller="Admin" asp-action="Viewproducts">
                View Products →
            </a>
        </div>

        <div class="dashboard-card">
            <h3>📊 Total Stock Items</h3>
            <div class="number">@(ViewBag.stock ?? 0)</div>
            <a asp-controller="Seller" asp-action="ManageStock">
                Manage Stock →
            </a>
        </div>

        <div class="dashboard-card">
            <h3>🛒 Total Orders</h3>
            <div class="number">@(ViewBag.orderCount ?? 0)</div>
            <a asp-controller="Seller" asp-action="Orders">
                View Orders →
            </a>
        </div>

    </div>
    *@

    <!-- Pending Orders -->
    <div class="section-box">

        <h2>Pending Orders</h2>

        <div class="order-search">
            <span class="search-icon">&#128269;</span>
            <input type="text"
                   class="order-search-input"
                   data-table="pending-orders-table"
                   placeholder="Search pending orders..."
                   aria-label="Search pending orders" />
        </div>

        <div class="table-container">

            <table class="order-table" id="pending-orders-table">

                <thead>
                    <tr>
                        <th>Product Image</th>
                        <th>Username</th>
                        <th>Quantity</th>
                        <th>Ordered Date</th>
                        <th>Total Price</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (ViewBag.ord is IEnumerable<Order> orders
                                        && orders.Any())
                    {
                        foreach (var item in orders)
                        {
                            <tr>
                                <td>
                                    @{
                                        var imagePath =
                                        item.ProductType?.ImagePath ?? "";

                                        var images = imagePath.Split(
                                        ',',
                                        StringSplitOptions.RemoveEmptyEntries
                                        );

                                        var firstImage = images.FirstOrDefault();
                                    }

                                    @if (!string.IsNullOrWhiteSpace(firstImage))
                                    {
                                        <img class="product-image"
                                             src="@Url.Content("~/Products/" + firstImage.Trim())"
                                             alt="Product image"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span>No image</span>
                                    }

                                    <p>@item.ProductType?.ProductName</p>
                                </td>

                                <td>@item.username</td>
                                <td>@item.quantity</td>
                                <td>@item.orderdate</td>
                                <td>@item.totalprice</td>

                                <td>
                                    <a class="btn btn-success"
                                       asp-action="ApproveOrder"
                                       asp-route-id="@item.Oid">
                                        Approve order
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="no-orders">
                                No orders available yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

    <!-- Recent Order History -->
    <div class="section-box recent">

        <h2>Recent Order History</h2>

        <div class="order-search">
            <span class="search-icon">&#128269;</span>
            <input type="text"
                   class="order-search-input"
                   data-table="order-history-table"
                   placeholder="Search order history..."
                   aria-label="Search order history" />
        </div>

        <div class="table-container">

            <table class="order-table" id="order-history-table">

                <thead>
                    <tr>
                        <th>Product Image</th>
                        <th>Username</th>
                        <th>Quantity</th>
                        <th>Ordered Date</th>
                        <th>Total Price</th>
                    </tr>
                </thead>

                <tbody>
                    @if (ViewBag.ordHis is IEnumerable<Order> orders1
                                        && orders1.Any())
                    {
                        foreach (var item in orders1)
                        {
                            <tr>
                                <td>
                                    @{
                                        var imagePath =
                                        item.ProductType?.ImagePath ?? "";

                                        var images = imagePath.Split(
                                        ',',
                                        StringSplitOptions.RemoveEmptyEntries
                                        );

                                        var firstImage = images.FirstOrDefault();
                                    }

                                    @if (!string.IsNullOrWhiteSpace(firstImage))
                                    {
                                        <img class="product-image"
                                             src="@Url.Content("~/Products/" + firstImage.Trim())"
                                             alt="Product image"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span>No image</span>
                                    }

                                    <p>@item.ProductType?.ProductName</p>
                                </td>

                                <td>@item.username</td>
                                <td>@item.quantity</td>
                                <td>@item.orderdate</td>
                                <td>@item.totalprice</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="no-orders">
                                No orders available yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>

<script>
    document.querySelectorAll(".order-search-input").forEach(input => {
        input.addEventListener("input", function () {

            const table = document.getElementById(this.dataset.table);
            const rows = table.querySelectorAll("tbody tr");
            const searchText = this.value.trim().toLowerCase();

            let visibleCount = 0;

            rows.forEach(row => {

                // Preserve the existing empty-orders message.
                if (row.querySelector(".no-orders")) {
                    return;
                }

                const matches = row.textContent
                    .toLowerCase()
                    .includes(searchText);

                row.style.display = matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            });

            let noResults = table.querySelector(".no-search-results");

            if (!noResults) {
                noResults = document.createElement("tr");
                noResults.className = "no-search-results";

                const cell = document.createElement("td");
                cell.colSpan = table.querySelectorAll("thead th").length;
                cell.textContent = "No matching orders found.";

                noResults.appendChild(cell);
                table.querySelector("tbody").appendChild(noResults);
            }

            noResults.style.display =
                visibleCount === 0 && searchText !== ""
                    ? "table-row"
                    : "none";
        });
    });
</script>
